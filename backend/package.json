{
  "name": "my-blog-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore ./data/** src/server.ts",
    "clean": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx test/app.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^7.0.0",
    "better-sqlite3": "13.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^3.29.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.20.4",
    "tsx": "^3.12.1",
    "typescript": "~5.9.3"
  }
}
